 "phrases": [
  {
   "say": "Ever wondered how blackjack actually works? Here it is in under a minute.",
   "cap": "Ever wondered how|blackjack actually works?|Here it is in under a minute.",
   "pause": 0.45
  },
  {
   "say": "You play against the dealer, not against the other players at the table.",
   "cap": "You play against the dealer,|not against the other players|at the table.",
   "pause": 0.45
  },
  {
   "say": "The goal is to get closer to twenty one than the dealer, without going over.",
   "cap": "The goal is to get|closer to 21 than the dealer,|without going over.",
   "pause": 0.45
  },
  {
   "say": "Number cards count as their number, and every face card counts as ten.",
   "cap": "Number cards count|as their number,|and every face card|counts as 10.",
   "pause": 0.45
  },
  {
   "say": "An ace counts as one or eleven, whichever helps your hand more.",
   "cap": "An ace counts as 1 or 11,|whichever helps your hand more.",
   "pause": 0.45
  },
  {
   "say": "You start with two cards. Say hit to take another card, or stand to stop.",
   "cap": "You start with two cards.|Say hit to take another card,|or stand to stop.",
   "pause": 0.45
  },
  {
   "say": "Go over twenty one and you bust, which means you lose that hand right away.",
   "cap": "Go over 21 and you bust,|which means you lose|that hand right away.",
   "pause": 0.45
  },
  {
   "say": "An ace and a ten value card as your first two cards is a blackjack, which usually pays three to two.",
   "cap": "An ace and a 10 value card|as your first two cards|is a blackjack,|which usually pays 3 to 2.",
   "pause": 0.45
  },
  {
   "say": "The dealer has no choices, and must keep drawing cards until they reach seventeen or more.",
   "cap": "The dealer has no choices,|and must keep drawing cards|until they reach 17 or more.",
   "pause": 0.45
  },
  {
   "say": "But here is the catch: you always play your hand before the dealer.",
   "cap": "But here is the catch:|you always play your hand|before the dealer.",
   "pause": 0.45
  },
  {
   "say": "If you bust, you lose, even when the dealer busts too.",
   "cap": "If you bust, you lose,|even when the dealer busts too.",
   "pause": 0.45
  },
  {
   "say": "Most of the casino's edge comes from that one rule: you go first.",
   "cap": "Most of the casino's edge|comes from that one rule:|you go first.",
   "pause": 0.45
  }
 ],
