 "phrases": [
  {
   "say": "Walk into most casinos, and try to find a clock. You won't.",
   "cap": "Walk into most casinos, | and try to find a clock. | You won't.",
   "pause": 0.45
  },
  {
   "say": "No clocks. Few windows. No sunset to remind you it's late.",
   "cap": "No clocks. | Few windows. | No sunset | to remind you it's late.",
   "pause": 0.45
  },
  {
   "say": "That is not an accident. It is by design.",
   "cap": "That is not an accident. | It is by design.",
   "pause": 0.45
  },
  {
   "say": "In the year two thousand, a former casino boss wrote a whole book on designing casinos.",
   "cap": "In the year 2000, | a former casino boss | wrote a whole book | on designing casinos.",
   "pause": 0.45
  },
  {
   "say": "His rules? Low ceilings, maze-like paths, and machines everywhere you turn.",
   "cap": "His rules? | Low ceilings, | maze-like paths, | and machines | everywhere you turn.",
   "pause": 0.45
  },
  {
   "say": "Real cash disappears too. You hold chips, so it doesn't feel like money.",
   "cap": "Real cash disappears too. | You hold chips, | so it doesn't feel like money.",
   "pause": 0.45
  },
  {
   "say": "And the free drinks? They're not free.",
   "cap": "And the free drinks? | They're not free.",
   "pause": 0.45
  },
  {
   "say": "They're paid for by the bets you make with a slower mind.",
   "cap": "They're paid for | by the bets you make | with a slower mind.",
   "pause": 0.45
  },
  {
   "say": "Every detail has one job. Keep you playing.",
   "cap": "Every detail has one job. | Keep you playing.",
   "pause": 0.45
  },
  {
   "say": "Because the longer you stay, the more the maths wins.",
   "cap": "Because the longer you stay, | the more the maths wins.",
   "pause": 0.45
  },
  {
   "say": "The house doesn't need luck. It just needs time.",
   "cap": "The house doesn't need luck. | It just needs time.",
   "pause": 0.45
  }
 ],
