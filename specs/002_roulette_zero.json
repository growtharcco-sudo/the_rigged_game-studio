 "phrases": [
  {
   "say": "Why does the casino always win at roulette? Look at this one green pocket.",
   "cap": "Why does the casino|always win at roulette?|Look at this|one green pocket.",
   "pause": 0.45
  },
  {
   "say": "A European wheel has thirty seven pockets: the numbers one to thirty six, plus a single zero.",
   "cap": "A European wheel|has 37 pockets:|the numbers 1 to 36,|plus a single zero.",
   "pause": 0.45
  },
  {
   "say": "Put a chip on one number and win, and the casino pays you thirty five to one.",
   "cap": "Put a chip on one number|and win, and the casino|pays you 35 to 1.",
   "pause": 0.45
  },
  {
   "say": "But with thirty seven pockets, a fair payout would be thirty six to one.",
   "cap": "But with 37 pockets,|a fair payout would be|36 to 1.",
   "pause": 0.45
  },
  {
   "say": "That one missing chip on every win is where the casino's edge comes from.",
   "cap": "That one missing chip|on every win is where|the casino's edge comes from.",
   "pause": 0.45
  },
  {
   "say": "It works out to a house edge of about two point seven percent on every bet.",
   "cap": "It works out to|a house edge of about|2.7% on every bet.",
   "pause": 0.45
  },
  {
   "say": "Bet ten dollars a spin for a thousand spins, and you can expect to lose about two hundred seventy dollars.",
   "cap": "Bet $10 a spin|for 1,000 spins,|and you can expect|to lose about $270.",
   "pause": 0.45
  },
  {
   "say": "American wheels add a second green pocket, the double zero, and the edge almost doubles to five point two six percent.",
   "cap": "American wheels add|a second green pocket,|the double zero, and the edge|almost doubles to 5.26%.",
   "pause": 0.45
  },
  {
   "say": "So the next time you lose at roulette, you were not unlucky.",
   "cap": "So the next time|you lose at roulette,|you were not unlucky.",
   "pause": 0.45
  },
  {
   "say": "You were playing against the zero.",
   "cap": "You were playing|against the zero.",
   "pause": 0.45
  }
 ],
