 "phrases": [
  {
   "say": "Ever watched a craps table and had no idea what was going on? Here is the game in under a minute.",
   "cap": "Ever watched a craps table|and had no idea|what was going on?|Here is the game|in under a minute.",
   "pause": 0.45
  },
  {
   "say": "The shooter rolls two dice, and the first roll is called the come out.",
   "cap": "The shooter rolls two dice,|and the first roll|is called the come out.",
   "pause": 0.45
  },
  {
   "say": "On the come out, a seven or an eleven wins for the pass line.",
   "cap": "On the come out,|a seven or an eleven|wins for the pass line.",
   "pause": 0.45
  },
  {
   "say": "A two, a three or a twelve is called craps, and the pass line loses.",
   "cap": "A two, a three or a twelve|is called craps,|and the pass line loses.",
   "pause": 0.45
  },
  {
   "say": "Any other number becomes the point, and the shooter keeps on rolling.",
   "cap": "Any other number|becomes the point,|and the shooter|keeps on rolling.",
   "pause": 0.45
  },
  {
   "say": "Roll the point again before a seven and the pass line wins. A seven first, and it loses.",
   "cap": "Roll the point again|before a seven|and the pass line wins.|A seven first,|and it loses.",
   "pause": 0.45
  },
  {
   "say": "A winning pass line bet pays even money, one to one.",
   "cap": "A winning pass line bet|pays even money,|1 to 1.",
   "pause": 0.45
  },
  {
   "say": "But here is the catch: the pass line wins only about forty nine point three percent of the time.",
   "cap": "But here is the catch:|the pass line wins|only about 49.3%|of the time.",
   "pause": 0.45
  },
  {
   "say": "Paid at even money, that leaves the house an edge of one point four one percent.",
   "cap": "Paid at even money,|that leaves the house|an edge of 1.41%.",
   "pause": 0.45
  },
  {
   "say": "And the loud bets in the middle are worse. Any seven carries sixteen point six seven percent.",
   "cap": "And the loud bets in the middle|are worse. Any seven carries|16.67%.",
   "pause": 0.45
  },
  {
   "say": "Craps feels like pure luck, but every bet on the felt has an edge.",
   "cap": "Craps feels like pure luck,|but every bet on the felt|has an edge.",
   "pause": 0.45
  }
