 "phrases": [
  {
   "say": "Can you count to nine? Then you can learn baccarat in under a minute.",
   "cap": "Can you count to nine?|Then you can learn baccarat|in under a minute.",
   "pause": 0.45
  },
  {
   "say": "Two hands are dealt, one called Player and one called Banker.",
   "cap": "Two hands are dealt,|one called Player|and one called Banker.",
   "pause": 0.45
  },
  {
   "say": "You bet on which hand will finish closest to nine, or on a tie.",
   "cap": "You bet on which hand|will finish closest to nine,|or on a tie.",
   "pause": 0.45
  },
  {
   "say": "Aces count as one, and two to nine count as their number.",
   "cap": "Aces count as one,|and two to nine|count as their number.",
   "pause": 0.45
  },
  {
   "say": "Tens and face cards are worth nothing at all, just zero.",
   "cap": "Tens and face cards|are worth nothing at all,|just zero.",
   "pause": 0.45
  },
  {
   "say": "If a hand goes over nine, only the last digit of the total counts.",
   "cap": "If a hand goes over nine,|only the last digit|of the total counts.",
   "pause": 0.45
  },
  {
   "say": "So a seven and an eight make fifteen, and that counts as five.",
   "cap": "So a seven and an eight|make 15,|and that counts as 5.",
   "pause": 0.45
  },
  {
   "say": "And here is the strange part: you make no decisions at all.",
   "cap": "And here is the strange part:|you make no decisions|at all.",
   "pause": 0.45
  },
  {
   "say": "Player and Banker bets pay even money, and a tie pays eight to one.",
   "cap": "Player and Banker bets|pay even money,|and a tie pays 8 to 1.",
   "pause": 0.45
  },
  {
   "say": "But here is the catch: the casino takes five percent of every winning Banker bet.",
   "cap": "But here is the catch:|the casino takes 5%|of every winning Banker bet.",
   "pause": 0.45
  },
  {
   "say": "With eight decks, that leaves a house edge of one point zero six percent on Banker.",
   "cap": "With eight decks,|that leaves a house edge|of 1.06% on Banker.",
   "pause": 0.45
  },
  {
   "say": "The Player bet gives up one point two four, and the tie gives up fourteen point three six.",
   "cap": "The Player bet gives up 1.24,|and the tie gives up|14.36.",
   "pause": 0.45
  },
  {
   "say": "Baccarat needs no skill at all. The house just needs its edge.",
   "cap": "Baccarat needs no skill at all.|The house just needs|its edge.",
   "pause": 0.45
  }
 ],
