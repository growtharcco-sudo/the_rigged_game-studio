 "phrases": [
  {
   "say": "There is a betting system that sounds like it can never lose. Here are four reasons it fails.",
   "cap": "There is a betting system|that sounds like|it can never lose.|Here are four reasons|it fails.",
   "pause": 0.45
  },
  {
   "say": "It is called the martingale: bet one dollar, and double your bet after every loss.",
   "cap": "It is called the martingale:|bet $1, and double your bet|after every loss.",
   "pause": 0.45
  },
  {
   "say": "When you finally win, you get back every loss, plus one dollar.",
   "cap": "When you finally win,|you get back every loss,|plus $1.",
   "pause": 0.45
  },
  {
   "say": "Number four. However long it takes, every win earns you just one dollar.",
   "cap": "Number four.|However long it takes,|every win earns you|just $1.",
   "pause": 0.45
  },
  {
   "say": "Number three. The bets grow fast: one, two, four, eight, sixteen dollars.",
   "cap": "Number three.|The bets grow fast:|$1, $2, $4, $8, $16.",
   "pause": 0.45
  },
  {
   "say": "After ten losses in a row, the next bet is one thousand and twenty four dollars, just to win one.",
   "cap": "After ten losses in a row,|the next bet is $1,024,|just to win $1.",
   "pause": 0.45
  },
  {
   "say": "Number two. Even on a fair coin, three losses in a row comes up one time in eight.",
   "cap": "Number two.|Even on a fair coin,|three losses in a row|comes up|1 time in 8.",
   "pause": 0.45
  },
  {
   "say": "And you only have so much money, so one long streak can wipe you out.",
   "cap": "And you only have|so much money,|so one long streak|can wipe you out.",
   "pause": 0.45
  },
  {
   "say": "And number one. Real roulette wheels have green pockets, so the house always keeps an edge.",
   "cap": "And number one.|Real roulette wheels|have green pockets,|so the house always|keeps an edge.",
   "pause": 0.45
  },
  {
   "say": "Even on a perfectly fair game, the small wins and the huge losses average out to zero.",
   "cap": "Even on a perfectly|fair game, the small wins|and the huge losses|average out to zero.",
   "pause": 0.45
  },
  {
   "say": "No system can beat the odds. It only makes the losses bigger.",
   "cap": "No system can beat the odds.|It only makes|the losses bigger.",
   "pause": 0.45
  }
 ],
